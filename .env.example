AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=gpt-realtime-whisper
# Optional future summarizer, separate from the live Realtime connection.
# Native bounded Realtime truncation currently avoids extra summary calls.
AZURE_OPENAI_SUMMARY_ENDPOINT=
AZURE_OPENAI_SUMMARY_API_KEY=
AZURE_OPENAI_SUMMARY_DEPLOYMENT=gpt-6-luna
PORT=3000
# Defaults to loopback locally and 0.0.0.0 when NODE_ENV=production.
EARRR_LISTEN_HOST=
DATABASE_PATH=data\earrr.sqlite
# These SQL options apply only to the explicit legacy single-user harness.
DATABASE_URL=
# Optional public deployment origin for canonical and absolute social metadata.
PUBLIC_ORIGIN=
# Comma-separated, exact owned origins. Public production origins must use HTTPS.
# PUBLIC_ORIGIN is also allowed; add the owned Azure default origin during rollout.
EARRR_ALLOWED_ORIGINS=
# Optional locally; deployed artifacts contain authoritative date/hash metadata.
RELEASE_ID=
COMMIT_SHA=
# Required for normal browser-guest / account-scoped runtime storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stable, private base64-encoded 32-byte key. Back it up with the database.
# Changing it makes existing guest and account saves unreadable.
LEARNING_SAVE_KEY=
# Leave disabled until Google OAuth is configured in the Supabase project.
SUPABASE_GOOGLE_ENABLED=false
# Operator setup only; SMTP credentials stay in Supabase, never in the browser.
SUPABASE_PROJECT_REF=
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@your-verified-domain.example
# Isolated tests / explicit old single-user mode only. Never use for account hosting.
EARRR_LEGACY_STORAGE=
