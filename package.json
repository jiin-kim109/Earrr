{
  "name": "earrr",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write server shared frontend",
    "format:check": "prettier --check server shared frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "node scripts/verify-postgres.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:live": "npm run build && tsx scripts/verify-live.ts",
    "test:auth": "tsx scripts/verify-auth.ts --managed-server",
    "test:welcome": "tsx scripts/verify-welcome.ts",
    "deploy:build": "node deploy/build.mjs",
    "deploy:package": "node deploy/package.mjs",
    "deploy:azure": "node deploy/deploy.mjs",
    "deploy:test": "node --test deploy/tests/delivery.test.mjs",
    "deploy:format:check": "prettier --check deploy .github/workflows playwright.config.ts package.json tests/production-hosting.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.45.0",
    "nunjucks": "^3.2.4",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.2",
    "zod": "^4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@napi-rs/keyring": "2.1.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.18.6",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "3.6.2",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
